# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Env files (contain internal network endpoints / keys)
backend/.env
.env
!.env.example

# Data -- /data (repo root) is the docker-compose.yml bind mount for
# /app/data: job uploads/outputs, the persistent dataset library, and OBS
# settings, INCLUDING the Fernet encryption key and encrypted credentials
# (storage/obs_settings.py). Ignore the whole tree, not just subfolders --
# these files must never be committed. backend/data/ covers the same
# concern when running the backend directly (outside Docker) from
# backend/, where a relative ./data path resolves there instead.
/data/
backend/data/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Neo4j local volumes
neo4j_data/
neo4j_logs/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Model caches (large, downloaded once and baked into image / volume instead)
backend/.cache/
backend/models_cache/*
!backend/models_cache/.gitkeep
!backend/models_cache/docling/
backend/models_cache/docling/*
!backend/models_cache/docling/.gitkeep
frontend/tsconfig.tsbuildinfo

# Corporate TLS-proxy root CA certs (private to your org, don't commit)
backend/certs/*
!backend/certs/.gitkeep
